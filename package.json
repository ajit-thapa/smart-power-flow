{
  "name": "smart-power-flow-card",
  "version": "1.0.0",
  "description": "A Home Assistant custom card for displaying power flow",
  "main": "dist/smart-power-flow-card.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=dist/smart-power-flow-card.js --external:lit --external:home-assistant-js-websocket --platform=browser",
    "dev": "esbuild src/index.ts --bundle --outfile=dist/smart-power-flow-card.js --external:lit --external:home-assistant-js-websocket --platform=browser --watch",
    "lint": "eslint src --ext .ts 2>/dev/null || true",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\" 2>/dev/null || true"
  },
  "keywords": ["home-assistant", "custom-card", "power-flow"],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0",
    "esbuild": "^0.20.0"
  }
}
